---
import Base from './Base.astro';
import { p } from '../utils/paths';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  section: string;
  heading: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  subnav?: NavItem[];
  compact?: boolean;
}

const { title, description, section, heading, intro, image, imageAlt = '', subnav = [], compact = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const sectionUrlMap: Record<string, string> = {
  'Our Team': '/our-team',
  'Our Firm': '/our-firm',
  'Services': '/services',
  'Views & News': '/news',
  'Contact': '/contact',
  'Disclosures': '/disclosure',
};

const sectionHref = sectionUrlMap[section] || '/';
const isRootSectionPage = path === sectionHref || path === p(sectionHref);
---

<Base title={title} description={description}>
  <section class:list={['page-hero', { 'is-compact': compact }]}>
    <div class="page-shell page-hero-grid">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={p('/')}>Home</a>
          <span aria-hidden="true">/</span>
          {
            isRootSectionPage ? (
              <span aria-current="page">{section}</span>
            ) : (
              <>
                <a href={p(sectionHref)} class="breadcrumb-link">{section}</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{heading}</span>
              </>
            )
          }
        </nav>
        <p class="page-kicker">
          {
            isRootSectionPage ? (
              section
            ) : (
              <a href={p(sectionHref)} class="kicker-link" title={`Return to ${section} overview`}>
                {section} <span aria-hidden="true">←</span>
              </a>
            )
          }
        </p>
        <h1>{heading}</h1>
        {intro && <p class="page-intro">{intro}</p>}
      </div>
      {image && <img src={p(image)} alt={imageAlt} width="938" height="406" />}
    </div>
  </section>

  {subnav.length > 0 && (
    <nav class="section-nav" aria-label={`${section} pages`}>
      <div class="page-shell">
        {subnav.map((item) => (
          <a href={p(item.href)} aria-current={path === item.href || path === p(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
    </nav>
  )}

  <div class:list={['page-shell', 'page-body', { 'is-compact': compact }]}>
    <slot />
  </div>
</Base>

<style>
  .page-shell {
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
  }

  .page-hero {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem);
    background: var(--color-board);
    color: white;
    border-bottom: 3px solid var(--color-crimson);
  }

  .page-hero.is-compact {
    padding: clamp(2rem, 3.5vw, 3rem) 0 clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .page-hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .page-hero-grid:has(img) {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .breadcrumbs a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.15s ease;
  }

  .breadcrumbs a:hover {
    color: white;
  }

  .breadcrumbs span[aria-current="page"] {
    color: rgba(255, 255, 255, 0.95);
  }

  .page-kicker {
    margin: 1rem 0 0;
    color: var(--color-crimson-light, #ff8a8a);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kicker-link {
    color: var(--color-crimson-light, #ff8a8a);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease;
  }

  .kicker-link:hover {
    color: white;
    text-decoration: underline;
  }

  .page-hero h1 {
    margin: 0.4rem 0 0;
    color: white;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.12;
    font-weight: 400;
  }

  .page-intro {
    max-width: 44rem;
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.5;
  }

  .page-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .section-nav {
    background: var(--color-paper-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .section-nav .page-shell {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    padding: 0.75rem 0;
  }

  .section-nav a {
    color: var(--color-ink-2);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.25rem 0;
    position: relative;
    text-decoration: none;
  }

  .section-nav a:hover,
  .section-nav a[aria-current="page"] {
    color: var(--color-crimson-deep);
  }

  .section-nav a[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: -0.75rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-crimson-deep);
  }

  .page-body {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(3.5rem, 6vw, 5rem);
  }

  .page-body.is-compact {
    padding-top: clamp(2rem, 3.5vw, 3rem);
  }
</style>
