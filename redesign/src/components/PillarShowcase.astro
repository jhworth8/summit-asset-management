---
import { p } from '../utils/paths';

interface Pillar {
  keyword: string;
  headline: string;
  caption: string;
  image: string;
  alt: string;
  link: string;
  linkLabel: string;
}

interface Props {
  kicker: string;
  heading: string;
  items: Pillar[];
}

const { kicker, heading, items } = Astro.props;
const pillars = items.map((item, index) => ({ ...item, index: String(index + 1).padStart(2, '0') }));
const total = String(pillars.length).padStart(2, '0');
---

<section class="pillar-showcase" aria-label={heading} data-pillar-showcase>
  <div class="institutional-shell">
    <div class="pillar-header-row">
      <div class="pillar-header">
        <p class="section-kicker">{kicker}</p>
        <h2>{heading}</h2>
      </div>

      <div class="pillar-nav-arrows">
        <button type="button" class="arrow-btn prev-btn" data-pillar-prev aria-label="Previous principle">
          <span aria-hidden="true">←</span>
        </button>
        <div class="counter-display">
          <strong data-current-index>01</strong>
          <span>/</span>
          <span>{total}</span>
        </div>
        <button type="button" class="arrow-btn next-btn" data-pillar-next aria-label="Next principle">
          <span aria-hidden="true">→</span>
        </button>
        <button type="button" class="arrow-btn toggle-btn" data-pillar-toggle aria-label="Pause automatic rotation" aria-pressed="false">
          <span aria-hidden="true" class="toggle-icon"></span>
        </button>
      </div>
    </div>

    <div class="pillar-tabs" role="tablist" aria-label={kicker}>
      {
        pillars.map((item, index) => (
          <button
            type="button"
            role="tab"
            class={`pillar-tab ${index === 0 ? 'is-active' : ''}`}
            data-pillar-tab={index}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`pillar-panel-${index}`}
            id={`pillar-tab-${index}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <span class="tab-progress-bar" aria-hidden="true">
              <span class="tab-progress-track"></span>
            </span>
            <span class="tab-num">{item.index}</span>
            <span class="tab-label">{item.keyword}</span>
          </button>
        ))
      }
    </div>

    <div class="pillar-stage">
      {
        pillars.map((item, index) => (
          <article
            class={`pillar-slide ${index === 0 ? 'is-active' : ''}`}
            data-pillar-slide={index}
            id={`pillar-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`pillar-tab-${index}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
          >
            <div class="pillar-copy">
              <div class="pillar-keyword-badge">
                <span class="badge-num">{item.index}</span>
                <strong class="badge-text">{item.keyword}</strong>
              </div>
              <h3 class="pillar-headline">{item.headline}</h3>
              <p class="pillar-caption">{item.caption}</p>
              <a href={p(item.link)} class="pillar-action-link">
                <span>{item.linkLabel}</span>
                <span aria-hidden="true" class="arrow">→</span>
              </a>
            </div>

            <div class="pillar-media">
              <div class="image-wrapper">
                <img
                  src={p(item.image)}
                  alt={item.alt}
                  width="938"
                  height="406"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="media-badge">
                <span>Summit Principle · {item.keyword}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Advancing is driven by the progress bar's own animation ending, so the
  // bar and the slide change can never drift apart, and pausing the CSS
  // animation (hover, focus, off-screen, the pause button) pauses rotation.
  let teardown: (() => void) | null = null;

  const initPillars = () => {
    const showcase = document.querySelector<HTMLElement>('[data-pillar-showcase]');
    if (!showcase || showcase.dataset.ready === 'true') return;
    showcase.dataset.ready = 'true';

    const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[data-pillar-tab]'));
    const slides = Array.from(showcase.querySelectorAll<HTMLElement>('[data-pillar-slide]'));
    const prevBtn = showcase.querySelector<HTMLButtonElement>('[data-pillar-prev]');
    const nextBtn = showcase.querySelector<HTMLButtonElement>('[data-pillar-next]');
    const toggleBtn = showcase.querySelector<HTMLButtonElement>('[data-pillar-toggle]');
    const counterDisplay = showcase.querySelector<HTMLElement>('[data-current-index]');

    const CYCLE_DURATION = 6500;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let currentIndex = 0;
    let stoppedByUser = reducedMotion;
    let hovering = false;
    let focusInside = false;
    let offscreen = false;

    const syncPaused = () => {
      // Also hold still while someone is editing the page's wording.
      const editingPage = document.documentElement.hasAttribute('data-summit-editing');
      const paused = stoppedByUser || hovering || focusInside || offscreen || editingPage;
      showcase.classList.toggle('is-paused', paused);
      toggleBtn?.setAttribute('aria-pressed', String(stoppedByUser));
      toggleBtn?.setAttribute('aria-label', stoppedByUser ? 'Resume automatic rotation' : 'Pause automatic rotation');
      toggleBtn?.classList.toggle('is-stopped', stoppedByUser);
    };

    const restartProgress = () => {
      tabs.forEach((tab, i) => {
        const track = tab.querySelector<HTMLElement>('.tab-progress-track');
        if (!track) return;
        track.style.animation = 'none';
        if (i === currentIndex && !stoppedByUser) {
          void track.offsetWidth;
          track.style.animation = `pillarTimer ${CYCLE_DURATION}ms linear forwards`;
        }
      });
    };

    const show = (newIndex: number, moveFocus = false) => {
      currentIndex = (newIndex + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const isActive = i === currentIndex;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });
      slides.forEach((slide, i) => {
        const isActive = i === currentIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
        slide.inert = !isActive;
      });
      if (counterDisplay) counterDisplay.textContent = String(currentIndex + 1).padStart(2, '0');
      if (moveFocus) tabs[currentIndex].focus();
      restartProgress();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => show(index));
      tab.querySelector('.tab-progress-track')?.addEventListener('animationend', () => {
        if (index === currentIndex) show(currentIndex + 1);
      });
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
        if (event.key in keys) {
          event.preventDefault();
          show(currentIndex + keys[event.key], true);
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          show(event.key === 'Home' ? 0 : tabs.length - 1, true);
        }
      });
    });

    prevBtn?.addEventListener('click', () => show(currentIndex - 1));
    nextBtn?.addEventListener('click', () => show(currentIndex + 1));
    toggleBtn?.addEventListener('click', () => {
      stoppedByUser = !stoppedByUser;
      syncPaused();
      restartProgress();
    });

    showcase.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') { hovering = true; syncPaused(); }
    });
    showcase.addEventListener('pointerleave', () => { hovering = false; syncPaused(); });
    showcase.addEventListener('focusin', () => { focusInside = true; syncPaused(); });
    showcase.addEventListener('focusout', (event) => {
      if (!showcase.contains(event.relatedTarget as Node | null)) { focusInside = false; syncPaused(); }
    });

    const observer = new IntersectionObserver(([entry]) => {
      offscreen = !entry.isIntersecting;
      syncPaused();
    });
    observer.observe(showcase);

    let touchStartX = 0;
    showcase.addEventListener('touchstart', (event: TouchEvent) => {
      touchStartX = event.changedTouches[0].screenX;
    }, { passive: true });
    showcase.addEventListener('touchend', (event: TouchEvent) => {
      const delta = event.changedTouches[0].screenX - touchStartX;
      if (Math.abs(delta) > 50) show(currentIndex + (delta < 0 ? 1 : -1));
    }, { passive: true });

    document.addEventListener('summit:editing', syncPaused);
    syncPaused();
    show(0);
    teardown = () => {
      observer.disconnect();
      document.removeEventListener('summit:editing', syncPaused);
    };
  };

  initPillars();
  document.addEventListener('astro:page-load', initPillars);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>

<style>
  .pillar-showcase {
    padding: 5.5rem 0;
    background: var(--color-paper-2);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .pillar-header-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  @media (min-width: 48rem) {
    .pillar-header-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .section-kicker {
    margin: 0 0 0.4rem 0;
    color: var(--color-crimson-deep);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pillar-header h2 {
    margin: 0;
    font-size: clamp(2rem, 3.8vw, 2.9rem);
    color: var(--color-board);
    line-height: 1.1;
  }

  /* Carousel Navigation Arrows */
  .pillar-nav-arrows {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-rule);
    width: fit-content;
  }

  .arrow-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    background: transparent;
    border: 1px solid var(--color-rule);
    color: var(--color-board);
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .arrow-btn:hover {
    background: var(--color-board);
    color: #ffffff;
    border-color: var(--color-board);
  }

  .counter-display {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-3);
    padding: 0 0.5rem;
  }

  .counter-display strong {
    color: var(--color-board);
    font-size: 0.95rem;
    font-weight: 700;
  }

  /* Interactive Tab Strip */
  .pillar-tabs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    margin-bottom: 2rem;
  }

  @media (max-width: 47.99rem) {
    .pillar-tabs {
      grid-template-columns: repeat(5, minmax(5.4rem, 1fr));
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .pillar-tabs::-webkit-scrollbar {
      display: none;
    }
  }

  .pillar-tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.1rem 1.25rem 1.25rem;
    background: #ffffff;
    border: 0;
    cursor: pointer;
    text-align: left;
    transition: background 0.25s ease, color 0.25s ease;
  }

  @media (max-width: 47.99rem) {
    .pillar-tab {
      padding: 0.75rem 0.6rem 0.85rem;
    }
  }

  .pillar-tab:hover {
    background: #faf8f5;
  }

  .pillar-tab.is-active {
    background: var(--color-board);
    color: #ffffff;
  }

  .tab-num {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-crimson);
  }

  .pillar-tab.is-active .tab-num {
    color: var(--color-crimson-light);
  }

  .tab-label {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-board);
    margin-top: 0.2rem;
  }

  .pillar-tab.is-active .tab-label {
    color: #ffffff;
  }

  /* Animated Timer Progress Bar at top of active tab */
  .tab-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    overflow: hidden;
  }

  .tab-progress-track {
    display: none;
    width: 100%;
    height: 100%;
    background: var(--color-crimson);
    transform-origin: left;
  }

  .pillar-tab.is-active .tab-progress-track {
    display: block;
  }

  @keyframes pillarTimer {
    0% {
      transform: scaleX(0);
    }
    100% {
      transform: scaleX(1);
    }
  }

  /* Animated Card Stage */
  .pillar-stage {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-rule);
    box-shadow: 0 4px 25px rgba(23, 47, 64, 0.06);
    min-height: 24rem;
    display: grid;
    grid-template-columns: 1fr;
  }

  .pillar-slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 1fr;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    /* Outgoing slide clears quickly so two slides' text never overlaps. */
    transition: opacity 0.18s ease-out, transform 0.18s ease-out, visibility 0s linear 0.18s;
    pointer-events: none;
  }

  .pillar-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.14s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.14s, visibility 0s;
  }

  @media (min-width: 56rem) {
    .pillar-slide {
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }
  }

  .pillar-copy {
    padding: 3rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 48rem) {
    .pillar-copy {
      padding: 3.5rem 3.5rem;
    }
  }

  .pillar-keyword-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .badge-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-crimson);
    letter-spacing: 0.08em;
  }

  .badge-text {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-board);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pillar-headline {
    margin: 0 0 1rem 0;
    font-size: clamp(1.8rem, 2.8vw, 2.4rem);
    line-height: 1.15;
    color: var(--color-board);
  }

  .pillar-caption {
    margin: 0 0 2rem 0;
    color: var(--color-ink-2);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 32rem;
  }

  .pillar-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-crimson-deep);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    width: fit-content;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .pillar-action-link:hover {
    color: var(--color-board);
  }

  .pillar-action-link:hover .arrow {
    transform: translateX(3px);
  }

  .arrow {
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .pillar-media {
    position: relative;
    background: var(--color-board);
    overflow: hidden;
    min-height: 18rem;
  }

  .image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .pillar-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pillar-slide.is-active .pillar-media img {
    transform: scale(1.03);
  }

  .media-badge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(23, 47, 64, 0.88);
    backdrop-filter: blur(4px);
    color: #ffffff;
    padding: 0.35rem 0.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .pillar-showcase.is-paused .tab-progress-track {
    animation-play-state: paused !important;
  }

  .toggle-icon {
    display: block;
    width: 0.7rem;
    height: 0.8rem;
    border-inline: 3px solid currentColor;
    box-sizing: border-box;
  }

  .toggle-btn.is-stopped .toggle-icon {
    width: 0;
    height: 0;
    border-block: 0.42rem solid transparent;
    border-inline: 0.7rem solid currentColor;
    border-right-width: 0;
    margin-left: 0.15rem;
  }

  .arrow-btn:focus-visible,
  .pillar-tab:focus-visible {
    outline: 2px solid var(--color-crimson);
    outline-offset: 2px;
  }
</style>
