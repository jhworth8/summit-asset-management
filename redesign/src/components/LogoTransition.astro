<div id="route-loader" class="route-loader" aria-hidden="true" transition:persist="summit-route-loader">
  <div class="route-loader__field">
    <div class="route-loader__mark">
      <img src="/img/logo.png" alt="" width="268" height="67" />
      <span class="route-loader__rule" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  let startedAt = 0;
  let releaseTimer = 0;
  let cleanupTimer = 0;

  const loader = () => document.getElementById('route-loader');
  const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const waitForPaint = () => new Promise<void>((resolve) => {
    requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
  });

  document.addEventListener('astro:before-preparation', (event: any) => {
    const originalLoader = event.loader;
    event.loader = async () => {
      window.clearTimeout(releaseTimer);
      window.clearTimeout(cleanupTimer);
      startedAt = performance.now();
      const current = loader();
      current?.classList.remove('is-releasing');
      current?.classList.add('is-active');

      // Fetch immediately while the veil paints. The earlier implementation
      // waited for its own animation before beginning preparation, making every
      // navigation feel slower than the page actually was.
      const preparation = originalLoader();
      await waitForPaint();
      current?.classList.add('is-visible');
      await Promise.all([
        preparation,
        reducedMotion()
          ? Promise.resolve()
          : new Promise<void>((resolve) => window.setTimeout(resolve, 135)),
      ]);
    };
  });

  document.addEventListener('astro:page-load', () => {
    const current = loader();
    if (!current?.classList.contains('is-active')) return;

    const reduced = reducedMotion();
    const minimum = reduced ? 0 : 300;
    const remaining = Math.max(0, minimum - (performance.now() - startedAt));

    releaseTimer = window.setTimeout(() => {
      current.classList.add('is-releasing');
      cleanupTimer = window.setTimeout(() => {
        current.classList.remove('is-active', 'is-visible', 'is-releasing');
      }, reduced ? 0 : 230);
    }, remaining);
  });
</script>

<style>
  :global(::view-transition-group(*)),
  :global(::view-transition-old(*)),
  :global(::view-transition-new(*)) {
    animation: none !important;
  }

  :global(::view-transition-group(summit-route-loader)) {
    z-index: 2147483647;
  }

  :global(::view-transition-old(summit-route-loader)),
  :global(::view-transition-new(summit-route-loader)) {
    animation: none;
    mix-blend-mode: normal;
  }

  .route-loader {
    position: fixed;
    z-index: 1000;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    contain: paint;
    transition:
      opacity 210ms ease,
      visibility 0s linear 210ms;
    will-change: opacity;
  }

  .route-loader__field {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    background: var(--color-paper);
  }

  .route-loader__mark {
    display: grid;
    width: min(13.5rem, calc(100vw - 4rem));
    justify-items: center;
    opacity: 0;
    transform: translateY(0.2rem) scale(0.985);
    transition:
      opacity 150ms ease 15ms,
      transform 260ms var(--ease-out-soft) 15ms;
  }

  .route-loader__mark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .route-loader__rule {
    display: block;
    width: 2.8rem;
    height: 2px;
    margin-top: 0.85rem;
    background: var(--color-crimson);
    transform: scaleX(0);
    transition: transform 220ms var(--ease-out-soft) 60ms;
  }

  .route-loader.is-active {
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 130ms ease,
      visibility 0s linear 0s;
  }

  .route-loader.is-visible {
    opacity: 1;
  }

  .route-loader.is-visible .route-loader__mark {
    opacity: 1;
    transform: translateY(0);
  }

  .route-loader.is-visible .route-loader__rule {
    transform: scaleX(1);
  }

  .route-loader.is-releasing {
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .route-loader.is-releasing .route-loader__mark {
    opacity: 0.5;
    transform: translateY(-0.08rem) scale(0.992);
    transition:
      opacity 150ms ease,
      transform 220ms var(--ease-out-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .route-loader,
    .route-loader *,
    .route-loader *::before,
    .route-loader *::after {
      animation: none !important;
      transition: none !important;
    }

    .route-loader.is-active .route-loader__mark {
      opacity: 1;
      transform: none;
    }
  }
</style>
