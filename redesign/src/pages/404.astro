---
import Page from '../layouts/Page.astro';
import { nav } from '../data/site';
import { p } from '../utils/paths';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Page
  title="Page not found | Summit Asset Management"
  description="The requested page could not be found."
  section="404"
  heading="We could not find that page."
  intro="The address may have changed. Use the links below to continue through the Summit website."
>
  <!--
    Old summitassetmanagement.com addresses (bookmarks, links in emails, search
    results) land here once the new site serves the domain. Forward the ones
    we know to their new home before the visitor ever sees this page.
  -->
  <script is:inline define:vars={{ base }}>
    (function () {
      var path = location.pathname;
      if (base && path.indexOf(base) === 0) path = path.slice(base.length);
      path = path.replace(/\/index\.html?$/i, '/').replace(/\.html?$/i, '').replace(/\/+$/, '').toLowerCase() || '/';
      var pdf = path.match(/^\/sites\/400\/uploaded\/files\/(.+\.pdf)$/i);
      var map = {
        '/our-team/advisors/alex-thompson': '/our-team/chairmen/alex-thompson-clu-chfc/',
        '/our-team/advisors/john-laughlin': '/our-team/principals/john-n-laughlin/',
        '/our-team/advisors/lance-hollingsworth': '/our-team/principals/lance-hollingsworth-cfp/',
        '/our-team/principals/john-n-laughlin-mba-': '/our-team/principals/john-n-laughlin/',
        '/our-team/advisors': '/our-team/?filter=advisors',
        '/our-team/principals': '/our-team/?filter=principals',
        '/our-team/chairmen': '/our-team/?filter=chairman',
        '/our-team/associates': '/our-team/?filter=associates',
        '/news/commentary-letters': '/news/',
        '/contact/our-location': '/contact/',
        '/contact/map': '/contact/',
        '/contact/inquiry-form': '/contact/',
        '/client-relationship-summary': '/client-relationship-summary/'
      };
      var target = pdf ? '/letters/' + location.pathname.split('/').pop() : map[path];
      if (target) location.replace(base + target);
    })();
  </script>

  <nav aria-label="Continue to another page" class="route-list">
    <a href={p('/')}><strong>Homepage</strong><span aria-hidden="true">→</span></a>
    {nav.map((item) => <a href={item.href}><strong>{item.label}</strong><span aria-hidden="true">→</span></a>)}
    <a href={p('/client-access')}><strong>Client access</strong><span aria-hidden="true">→</span></a>
  </nav>
</Page>

<style>
  .route-list {
    max-width: 52rem;
    border-top: 1px solid var(--color-rule);
  }

  .route-list a {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-rule-soft);
    color: var(--color-ink);
  }

  .route-list a:hover {
    color: var(--color-crimson);
  }
</style>
