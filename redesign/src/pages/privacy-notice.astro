---
import Page from '../layouts/Page.astro';
import legal from '../content/pages/legal.json';
import { documents } from '../data/site';

const content = legal.privacy;
const doc = documents.privacy;
---
<Page title={`${content.heading} | Summit Asset Management`} description="Summit Asset Management's privacy notice." section="Disclosures" heading={content.heading} intro={content.intro}>
  <div class="document-link"><div><p>Current document</p><h2>{doc.title} · {doc.date}</h2><span>PDF</span></div><a href={doc.href} target="_blank" rel="noopener">Open the privacy notice →</a></div>
  <style>.document-link{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem;border-block:1px solid var(--color-ink);background:var(--color-paper-2)}p{margin:0;color:var(--color-crimson-deep);font-size:.72rem;font-weight:700;text-transform:uppercase}h2{margin:.4rem 0 0;font-size:1.6rem}span{color:var(--color-ink-3);font-size:.76rem}.document-link a{padding:.8rem 1rem;background:var(--color-crimson);color:white;font-size:.82rem;font-weight:700}.document-link a:hover{background:var(--color-crimson-deep)}</style>
</Page>
