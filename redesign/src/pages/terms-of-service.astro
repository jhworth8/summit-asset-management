---
import Page from '../layouts/Page.astro';
import legal from '../content/pages/legal.json';
import { p } from '../utils/paths';

const content = legal.terms;
---
<Page title="Terms of Service | Summit Asset Management" description="Terms of service for the Summit Asset Management website." section="Disclosures" heading={content.heading} intro={content.intro}>
  <div class="terms">
    {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p><a href={p('/disclosure')}>View disclosures →</a></p>
  </div>
  <style>.terms{max-width:48rem}.terms p{margin:0 0 1rem;color:var(--color-ink-2);line-height:1.65}.terms p:first-child{margin-top:0}.terms a{color:var(--color-crimson-deep);font-weight:700;text-decoration:underline;text-underline-offset:.2em}</style>
</Page>
