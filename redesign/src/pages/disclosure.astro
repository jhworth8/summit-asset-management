---
import Page from '../layouts/Page.astro';
import legal from '../content/pages/legal.json';
import { documents } from '../data/site';

const content = legal.disclosures;
const docs = [documents.crs, documents.brochure, documents.privacy];
---
<Page title="Disclosures | Summit Asset Management" description="Regulatory disclosures, Form ADV Part 2, Form CRS and privacy notice for Summit Asset Management." section="Disclosures" heading={content.heading} intro={content.intro}>
  <div class="disclosure-sections">
    {content.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}
  </div>
  <h2 class="documents-heading">{content.documentsHeading}</h2>
  <ul class="documents">
    {docs.map((doc) => <li><div><h3>{doc.title}</h3><p>{doc.date}</p></div><a href={doc.href} target="_blank" rel="noopener">Open PDF →</a></li>)}
  </ul>
  <p class="registration">{content.registrationNote}</p>
  <style>.disclosure-sections{display:grid;gap:1.75rem;max-width:48rem}.disclosure-sections h2,.documents-heading{margin:0 0 .4rem;color:var(--color-board);font-size:1.45rem}.disclosure-sections p{margin:0;color:var(--color-ink-2);line-height:1.65}.documents-heading{margin-top:3rem}.documents{margin:.75rem 0 0;padding:0;border-top:1px solid var(--color-ink);list-style:none}.documents li{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.2rem 0;border-bottom:1px solid var(--color-rule)}.documents h3{margin:0;color:var(--color-board);font-size:1.25rem}.documents p{margin:.25rem 0 0;color:var(--color-ink-3);font-size:.78rem}.documents a{flex-shrink:0;color:var(--color-crimson-deep);font-size:.8rem;font-weight:700}.registration{max-width:48rem;margin-top:2rem;color:var(--color-ink-2);font-size:.85rem;line-height:1.55}</style>
</Page>
