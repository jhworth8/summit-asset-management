---
import Base from '../layouts/Base.astro';
import PillarShowcase from '../components/PillarShowcase.astro';
import home from '../content/pages/home.json';
import { firm, getLetters, getTeam } from '../data/site';
import { p } from '../utils/paths';

const team = await getTeam();
const [latestLetter] = await getLetters();

const services = [
  { ...home.services.investment, number: '01', href: p('/services/investment-management') },
  { ...home.services.planning, number: '02', href: p('/services/financial-planning') },
];
---

<Base title={home.seoTitle} description={home.seoDescription}>
  <section class="institutional-hero video-hero">
    <div class="hero-media" aria-hidden="true">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={p('/img/summit-hero-poster.webp')}
      >
        <source src={p('/video/summit-hero-film.mp4')} type="video/mp4" />
      </video>
    </div>

    <div class="institutional-shell hero-columns video-hero-content">
      <div class="hero-message">
        <p class="kicker" data-reveal>{home.hero.kicker}</p>
        <h1 data-reveal data-delay="0.03">{home.hero.headline}</h1>
        <p class="hero-intro" data-reveal data-delay="0.06">{home.hero.intro}</p>
        <div class="hero-actions" data-reveal data-delay="0.09">
          <a href={p('/contact')} class="solid-button">{home.hero.primaryButton}</a>
          <a href={p('/services')} class="plain-link">{home.hero.secondaryButton} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <div class="institutional-shell trust-strip" aria-label="About Summit">
      {home.facts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
    </div>
  </section>

  <script>
    const setupHeroDepth = () => {
      const hero = document.querySelector<HTMLElement>('.video-hero');
      if (!hero || hero.dataset.depthReady === 'true') return;
      hero.dataset.depthReady = 'true';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let scheduled = false;

      const applyParallax = () => {
        scheduled = false;
        if (prefersReducedMotion.matches) {
          hero.style.removeProperty('--hero-scroll-progress');
          hero.style.removeProperty('--hero-media-opacity');
          hero.style.removeProperty('--hero-media-scale');
          hero.style.removeProperty('--hero-media-shift');
          hero.style.removeProperty('--hero-content-opacity');
          hero.style.removeProperty('--hero-content-shift');
          return;
        }

        const headerHeight = (document.querySelector('.site-header') as HTMLElement | null)?.offsetHeight ?? 0;
        const heroCover = document.querySelector('.hero-cover') as HTMLElement | null;
        const coverTop = heroCover ? heroCover.getBoundingClientRect().top : window.innerHeight;
        const totalDistance = Math.max(1, window.innerHeight - headerHeight);
        const distanceCovered = totalDistance - (coverTop - headerHeight);
        const rawProgress = Math.max(0, distanceCovered / totalDistance);
        const progress = Math.min(1, rawProgress);

        hero.style.setProperty('--hero-scroll-progress', progress.toFixed(4));
        hero.style.setProperty('--hero-media-opacity', (1 - progress * 0.38).toFixed(4));
        hero.style.setProperty('--hero-media-scale', (1 + progress * 0.035).toFixed(4));
        hero.style.setProperty('--hero-media-shift', `${(progress * 1.5).toFixed(3)}rem`);
        hero.style.setProperty('--hero-content-opacity', (1 - progress * 0.82).toFixed(4));
        hero.style.setProperty('--hero-content-shift', `${(progress * -2.25).toFixed(3)}rem`);
      };

      const onScroll = () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(applyParallax);
        }
      };

      // The hero is pinned while the page slides over it. If its content
      // (headline plus fact strip) is taller than the screen, pinning would
      // hide the bottom of it for good, so let it scroll normally instead.
      const updatePinning = () => {
        hero.classList.remove('is-unpinned');
        hero.classList.toggle('is-unpinned', hero.scrollHeight > hero.clientHeight + 1);
      };

      updatePinning();
      document.fonts?.ready.then(updatePinning);
      applyParallax();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { updatePinning(); onScroll(); }, { passive: true });
      prefersReducedMotion.addEventListener('change', onScroll);
    };

    setupHeroDepth();
    document.addEventListener('astro:page-load', setupHeroDepth);
  </script>

  <div class="hero-cover">
  <section id="services" class="institutional-section expertise-section">
    <div class="institutional-shell">
      <div class="institutional-heading" data-reveal>
        <p class="kicker">{home.services.kicker}</p>
        <h2>{home.services.heading}</h2>
        <p>{home.services.intro}</p>
      </div>

      <div class="expertise-grid">
        {
          services.map((service, index) => (
            <article class="expertise-item" data-reveal data-delay={index * 0.05}>
              <p class="item-number">Service {service.number}</p>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              <ul>
                {service.points.map((detail) => <li>{detail}</li>)}
              </ul>
              <a href={service.href}>Explore {service.title.toLowerCase()} <span aria-hidden="true">→</span></a>
            </article>
          ))
        }
      </div>

      <div id="who-we-help" class="audience-panel" data-reveal>
        <div class="audience-title">
          <p class="kicker">{home.audiences.kicker}</p>
          <h2>{home.audiences.heading}</h2>
        </div>
        <ul>
          {
            home.audiences.items.map((item) => (
              <li>
                {item.link ? (
                  <a href={p(item.link)}><strong>{item.title}</strong><span>{item.body}</span></a>
                ) : (
                  <div><strong>{item.title}</strong><span>{item.body}</span></div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <PillarShowcase kicker={home.principles.kicker} heading={home.principles.heading} items={home.principles.items} />

  <section id="why-summit" class="institutional-section firm-section">
    <div class="institutional-shell firm-columns">
      <figure class="firm-editorial" data-reveal>
        <img
          src={p(home.whySummit.image)}
          alt={home.whySummit.imageAlt}
          width="620"
          height="260"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span>{home.whySummit.imageLabel}</span>
          <strong>{home.whySummit.imageCaption}</strong>
        </figcaption>
      </figure>

      <div class="firm-copy">
        <div class="institutional-heading" data-reveal>
          <p class="kicker">{home.whySummit.kicker}</p>
          <h2>{home.whySummit.heading}</h2>
          <p>{home.whySummit.intro}</p>
        </div>

        <dl class="distinction-list">
          {
            home.whySummit.points.map((point, index) => (
              <div data-reveal data-delay={index * 0.04}>
                <dt>{point.title}</dt>
                <dd>{point.body}</dd>
              </div>
            ))
          }
        </dl>

        <nav class="firm-pathways" aria-label="Explore Summit" data-reveal>
          {
            home.whySummit.links.map((link) => (
              <a href={p(link.href)}>
                <span>{link.label}</span>
                <strong>{link.text}</strong>
                <i aria-hidden="true">→</i>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </section>

  <section id="team" class="institutional-section team-section">
    <div class="institutional-shell">
      <div class="team-heading" data-reveal>
        <div>
          <p class="kicker">{home.team.kicker}</p>
          <h2>{home.team.heading}</h2>
        </div>
        <p>{home.team.intro}</p>
      </div>

      <ul class="people-directory" aria-label="Summit team">
        {
          team.map((person, index) => (
            <li data-reveal data-delay={index * 0.025}>
              <a href={person.href} aria-label={`View ${person.name}'s profile`}>
                <img src={person.photo} alt="" width="180" height="220" loading="lazy" />
                <strong>{person.name}</strong>
                <span>{person.shortRole}{person.credentials && ` · ${person.credentials}`}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contact" class="institutional-section closing-section">
    <div class="institutional-shell closing-columns">
      <div class="closing-message" data-reveal>
        <p class="kicker">{home.closing.kicker}</p>
        <h2>{home.closing.heading}</h2>
        <p>{home.closing.body}</p>
        <div class="closing-actions">
          <a href={`mailto:${firm.email}`} class="solid-button">{home.closing.emailButton}</a>
          <a href={firm.phoneHref} class="plain-link">Call {firm.phone}</a>
        </div>
      </div>

      {
        latestLetter && (
          <aside class="letter-summary" data-reveal data-delay="0.04">
            <p class="kicker">{home.closing.letterKicker}</p>
            <h3>{latestLetter.monthYear}: “{latestLetter.title}”</h3>
            <p>{home.closing.letterBody}</p>
            <a href={latestLetter.href} target="_blank" rel="noopener">Read the latest letter (PDF) <span aria-hidden="true">→</span></a>
            <a href={p('/news')}>View all letters <span aria-hidden="true">→</span></a>
          </aside>
        )
      }
    </div>
  </section>
  </div>
</Base>
