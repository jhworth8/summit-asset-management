---
import Page from '../../layouts/Page.astro';
import content from '../../content/pages/attributes.json';
import { documents } from '../../data/site';
const subnav = [
  { label: 'Overview', href: '/our-firm' },
  { label: 'Firm attributes', href: '/our-firm/attributes' },
  { label: 'Our history', href: '/our-firm/history' },
];
---

<Page title={content.seoTitle} description={content.seoDescription} section="Our Firm" heading={content.heading} intro={content.intro} subnav={subnav}>
  <ol class="attribute-list">
    {content.items.map((attribute, index) => (
      <li><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{attribute.title}</h2><p>{attribute.body}</p></div></li>
    ))}
  </ol>
  <aside class="disclosure-callout">
    <h2>{content.brochureHeading}</h2>
    <p>{content.brochureBody}</p>
    <a href={documents.brochure.href} target="_blank" rel="noopener">{content.brochureLink} →</a>
  </aside>
  <style>
    .attribute-list{margin:0;padding:0;border-top:1px solid var(--color-ink);list-style:none}.attribute-list li{display:grid;grid-template-columns:2.5rem 1fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid var(--color-rule)}.attribute-list>li>span{padding-top:.35rem;color:var(--color-crimson-deep);font-size:.74rem;font-weight:700}.attribute-list h2{margin:0;color:var(--color-board);font-size:1.55rem}.attribute-list p{max-width:50rem;margin:.35rem 0 0;color:var(--color-ink-2);line-height:1.55}.disclosure-callout{margin-top:2.5rem;padding:1.5rem;border-left:5px solid var(--color-crimson);background:var(--color-paper-2)}.disclosure-callout h2{margin:0;font-size:1.45rem}.disclosure-callout p{max-width:45rem;color:var(--color-ink-2);line-height:1.55}.disclosure-callout a{color:var(--color-crimson-deep);font-weight:700;text-decoration:underline;text-underline-offset:.2em}@media(min-width:60rem){.attribute-list{display:grid;grid-template-columns:repeat(2,1fr)}.attribute-list li{padding:1.5rem}.attribute-list li:nth-child(odd){padding-left:0;border-right:1px solid var(--color-rule)}.attribute-list li:nth-child(even){padding-right:0}}
  </style>
</Page>
