---
import Page from '../../layouts/Page.astro';
import content from '../../content/pages/history.json';
const subnav = [
  { label: 'Overview', href: '/our-firm' },
  { label: 'Firm attributes', href: '/our-firm/attributes' },
  { label: 'Our history', href: '/our-firm/history' },
];
---

<Page title={content.seoTitle} description={content.seoDescription} section="Our Firm" heading={content.heading} intro={content.intro} image={content.image} imageAlt={content.imageAlt} subnav={subnav}>
  <div class="history-grid">
    <div class="history-prose">
      <h2>{content.storyHeading}</h2>
      {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <ol class="timeline">
      {content.milestones.map((milestone) => <li><strong>{milestone.year}</strong><p>{milestone.text}</p></li>)}
    </ol>
  </div>
  <style>
    .history-grid{display:grid;gap:3rem}.history-prose{max-width:38rem}.history-prose h2{margin:0;font-size:2rem}.history-prose p{margin:1rem 0 0;color:var(--color-ink-2);line-height:1.68}.timeline{margin:0;padding:0;border-top:1px solid var(--color-ink);list-style:none}.timeline li{display:grid;grid-template-columns:5rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-rule)}.timeline strong{color:var(--color-crimson-deep);font-family:var(--font-serif);font-size:1.3rem}.timeline p{margin:0;color:var(--color-ink-2);line-height:1.5}@media(min-width:64rem){.history-grid{grid-template-columns:.75fr 1.25fr;gap:6rem}}
    @media(min-width:64rem){.timeline{position:sticky;top:7rem;align-self:start}}
  </style>
</Page>
