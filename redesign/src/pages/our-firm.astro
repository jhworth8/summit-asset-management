---
import Page from '../layouts/Page.astro';
import content from '../content/pages/firm.json';
import { p } from '../utils/paths';

const subnav = [
  { label: 'Overview', href: '/our-firm' },
  { label: 'Firm attributes', href: '/our-firm/attributes' },
  { label: 'Our history', href: '/our-firm/history' },
];
---

<Page
  title={content.seoTitle}
  description={content.seoDescription}
  section="Our Firm"
  heading={content.heading}
  intro={content.intro}
  image={content.image}
  imageAlt={content.imageAlt}
  subnav={subnav}
>
  <section class="firm-overview">
    <div>
      <p class="body-kicker">{content.kicker}</p>
      <h2>{content.sectionHeading}</h2>
    </div>
    <div class="prose">
      {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <div class="firm-links">
    <a href={p('/our-firm/attributes')}><span>Firm attributes</span><strong>{content.attributesLink}</strong><em>Read more →</em></a>
    <a href={p('/our-firm/history')}><span>Our history</span><strong>{content.historyLink}</strong><em>Read more →</em></a>
  </div>

  <style>
    .firm-overview { display:grid; gap:2rem; }
    .body-kicker,.firm-links span { margin:0; color:var(--color-crimson-deep); font-size:.74rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    h2 { max-width:18ch; margin:.6rem 0 0; font-size:clamp(2rem,4vw,3.2rem); line-height:1.03; }
    .prose { max-width:42rem; color:var(--color-ink-2); line-height:1.68; }
    .prose p { margin:0 0 1rem; }
    .prose p:first-child { margin-top:0; }
    .firm-links { display:grid; margin-top:3rem; border-block:1px solid var(--color-ink); }
    .firm-links a { display:flex; flex-direction:column; gap:.65rem; padding:1.5rem 0; border-bottom:1px solid var(--color-rule); }
    .firm-links a:last-child { border-bottom:0; }
    .firm-links strong { max-width:34rem; color:var(--color-board); font-family:var(--font-serif); font-size:1.45rem; line-height:1.15; }
    .firm-links em { color:var(--color-crimson-deep); font-size:.82rem; font-style:normal; font-weight:700; }
    @media(min-width:64rem){ .firm-overview{grid-template-columns:.8fr 1.2fr;gap:5rem}.firm-links{grid-template-columns:repeat(2,1fr)}.firm-links a{padding:2rem;border-right:1px solid var(--color-rule);border-bottom:0}.firm-links a:first-child{padding-left:0}.firm-links a:last-child{padding-right:0;border-right:0} }
  </style>
</Page>
