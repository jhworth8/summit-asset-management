---
import Page from '../layouts/Page.astro';
import content from '../content/pages/contact.json';
import { firm } from '../data/site';
---
<Page title={content.seoTitle} description={content.seoDescription} section="Contact" heading={content.heading} intro={content.intro} image={content.image} imageAlt={content.imageAlt}>
  <div class="contact-grid">
    <section><p>Telephone</p><a href={firm.phoneHref}>{firm.phone}</a><span>Fax {firm.fax}</span></section>
    <section><p>Email</p><a href={`mailto:${firm.email}`}>{firm.email}</a><span>{content.emailNote}</span></section>
    <section><p>Office</p><address>{firm.building}<br />{firm.street}<br />{firm.city}, {firm.state} {firm.zip}</address><a class="map-link" href={firm.mapUrl} target="_blank" rel="noopener noreferrer">Open directions in Google Maps →</a></section>
  </div>
  <aside class="contact-note"><h2>{content.directionsHeading}</h2><p>{content.directions}</p></aside>
  <style>
    .contact-grid{display:grid;border-block:1px solid var(--color-ink)}.contact-grid section{display:flex;flex-direction:column;gap:.35rem;padding:1.4rem 0;border-bottom:1px solid var(--color-rule)}.contact-grid section:last-child{border-bottom:0}.contact-grid p{margin:0;color:var(--color-crimson-deep);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.contact-grid a:not(.map-link),.contact-grid address{overflow-wrap:anywhere;color:var(--color-board);font-family:var(--font-serif);font-size:1.4rem;font-style:normal;line-height:1.25}.contact-grid span{color:var(--color-ink-3);font-size:.76rem}.map-link{margin-top:.5rem;color:var(--color-crimson-deep);font-size:.78rem;font-weight:700}.contact-note{display:grid;gap:.5rem;margin-top:2.5rem;padding:1.5rem;border-left:5px solid var(--color-crimson);background:var(--color-paper-2)}.contact-note h2{margin:0;font-size:1.4rem}.contact-note p{max-width:48rem;margin:0;color:var(--color-ink-2);line-height:1.55}@media(min-width:60rem){.contact-grid{grid-template-columns:repeat(3,1fr)}.contact-grid section{padding:1.5rem;border-right:1px solid var(--color-rule);border-bottom:0}.contact-grid section:first-child{padding-left:0}.contact-grid section:last-child{padding-right:0;border-right:0}.contact-note{grid-template-columns:12rem 1fr;align-items:center}}
  </style>
</Page>
