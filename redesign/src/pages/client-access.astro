---
import Page from '../layouts/Page.astro';
import content from '../content/pages/client-access.json';
---
<Page title={content.seoTitle} description={content.seoDescription} section="Client Access" heading={content.heading} intro={content.intro}>
  <div class="access-grid">
    {[content.portal, content.schwab].map((block) => (
      <section>
        <p>{block.kicker}</p>
        <h2>{block.heading}</h2>
        {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a href={block.url} target="_blank" rel="noopener noreferrer">{block.linkLabel} <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a>
      </section>
    ))}
  </div>
  <p class="custodian-disclaimer">{content.disclaimer}</p>
  <style>
    .access-grid{display:grid;border-block:1px solid var(--color-ink)}.access-grid section{padding:1.5rem 0;border-bottom:1px solid var(--color-rule)}.access-grid section:last-child{border-bottom:0}.access-grid section>p:first-child{margin:0;color:var(--color-crimson-deep);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.access-grid h2{margin:.6rem 0 0;color:var(--color-board);font-size:1.8rem;line-height:1.08}.access-grid section>p:not(:first-child){margin:.8rem 0 0;color:var(--color-ink-2);line-height:1.58}.access-grid section>p:last-of-type{margin-bottom:1rem}.access-grid a{display:inline-block;margin-top:.5rem;padding:.8rem 1.1rem;background:var(--color-crimson);color:white;font-size:.85rem;font-weight:700}.access-grid a:hover{background:var(--color-crimson-deep)}.custodian-disclaimer{max-width:56rem;margin-top:2rem;color:var(--color-ink-3);font-size:.78rem;line-height:1.6}@media(min-width:60rem){.access-grid{grid-template-columns:repeat(2,1fr)}.access-grid section{padding:2rem;border-right:1px solid var(--color-rule);border-bottom:0}.access-grid section:first-child{padding-left:0}.access-grid section:last-child{padding-right:0;border-right:0}}
  </style>
</Page>
