---
import Page from '../layouts/Page.astro';
import content from '../content/pages/news.json';
import { getLetters } from '../data/site';

const letters = await getLetters();
const years = [...new Set(letters.map((letter) => letter.year))];
const archive = years.map((year) => ({ year, items: letters.filter((letter) => letter.year === year) }));
---
<Page title={content.seoTitle} description={content.seoDescription} section="Views & News" heading={content.heading} intro={content.intro} image={content.image} imageAlt={content.imageAlt}>
  <div class="archive-intro"><h2>{content.archiveHeading}</h2><p>{content.archiveNote}</p></div>
  <div class="letter-archive">
    {archive.map((group) => (
      <section>
        <h2>{group.year}</h2>
        <ul>
          {group.items.map((letter) => (
            <li>
              <a href={letter.href} target="_blank" rel="noopener">
                <div><strong>{letter.label}</strong><span>“{letter.title}”</span></div>
                <em>PDF <span class="visually-hidden">(opens in a new tab)</span>↗</em>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <style>
    .archive-intro{display:grid;gap:1rem;margin-bottom:2.5rem}.archive-intro h2{margin:0;font-size:clamp(2rem,4vw,3rem)}.archive-intro p{max-width:44rem;margin:0;color:var(--color-ink-2);line-height:1.6}.letter-archive{border-top:1px solid var(--color-ink)}.letter-archive section{display:grid;padding:1.3rem 0;border-bottom:1px solid var(--color-ink)}.letter-archive section>h2{margin:0 0 1rem;color:var(--color-crimson-deep);font-size:1.4rem}.letter-archive ul{margin:0;padding:0;list-style:none}.letter-archive li{border-top:1px solid var(--color-rule)}.letter-archive a{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem 0}.letter-archive strong,.letter-archive span{display:block}.letter-archive strong{color:var(--color-board);font-family:var(--font-serif);font-size:1.15rem}.letter-archive span{margin-top:.2rem;color:var(--color-ink-3);font-size:.8rem}.letter-archive em{flex-shrink:0;color:var(--color-crimson-deep);font-size:.72rem;font-style:normal;font-weight:700}@media(min-width:60rem){.archive-intro{grid-template-columns:.7fr 1.3fr;gap:5rem}.letter-archive section{grid-template-columns:10rem 1fr}.letter-archive section>h2{margin:0}}
  </style>
</Page>
