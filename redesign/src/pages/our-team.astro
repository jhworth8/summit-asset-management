---
import Page from '../layouts/Page.astro';
import { teamProfiles } from '../data/profiles';
import { p } from '../utils/paths';

const filters = [
  ['all', 'All'],
  ['chairman', 'Chairman'],
  ['principals', 'Principals'],
  ['advisors', 'Advisors'],
  ['associates', 'Associates'],
];
---

<Page title="Our Team | Summit Asset Management" description="Meet Summit Asset Management's experienced, collaborative team of advisors and professionals in Memphis." section="Our Team" heading="Experienced people. Collective perspective." intro="Clients have a primary advisor and the benefit of a collaborative firm with deep and diverse experience.">
  <div class="team-intro">
    <h2>A personal relationship, supported by a team.</h2>
    <p>Summit’s culture ensures that each client benefits from the firm’s collective knowledge without losing the personal touch of a primary advisor who knows the relationship in depth.</p>
  </div>

  <div class="team-filters" role="group" aria-label="Filter team by role" data-team-filters>
    {filters.map(([value, label], index) => (
      <button type="button" data-team-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>
        {label}<span>{value === 'all' ? teamProfiles.length : teamProfiles.filter((person) => person.group === value).length}</span>
      </button>
    ))}
  </div>

  <ul class="team-grid" data-team-grid>
    {teamProfiles.map((person) => (
      <li data-team-member data-team-group={person.group}>
        <a href={p(`/our-team/${person.slug}`)}>
          <img src={person.photo} alt={person.name} width="600" height="720" loading="lazy" />
          {person.note && <span class="profile-note">{person.note}</span>}
          <h2>{person.name}{person.credentials && <small>, {person.credentials}</small>}</h2>
          <p>{person.title}</p>
          <span class="profile-link">Read biography →</span>
        </a>
      </li>
    ))}
  </ul>

  <script>
    const setupTeamFilters = () => {
      document.querySelectorAll<HTMLElement>('[data-team-filters]').forEach((controls) => {
        if (controls.dataset.ready === 'true') return;
        controls.dataset.ready = 'true';
        const grid = controls.nextElementSibling;
        const members = [...(grid?.querySelectorAll<HTMLElement>('[data-team-member]') || [])];
        const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-team-filter]')];

        const applyFilter = (filter: string) => {
          buttons.forEach((item) => item.setAttribute('aria-pressed', String((item.dataset.teamFilter || 'all') === filter)));
          members.forEach((member) => {
            member.hidden = filter !== 'all' && member.dataset.teamGroup !== filter;
          });
        };

        buttons.forEach((button) => button.addEventListener('click', () => {
          const filter = button.dataset.teamFilter || 'all';
          applyFilter(filter);
        }));

        // Check if there is a URL query param ?filter=
        const urlParams = new URLSearchParams(window.location.search);
        const initialFilter = urlParams.get('filter');
        if (initialFilter) {
          applyFilter(initialFilter);
        }
      });
    };
    setupTeamFilters();
    document.addEventListener('astro:page-load', setupTeamFilters);
  </script>

  <style>
    .team-intro{display:grid;gap:1rem;margin-bottom:2.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--color-rule)}.team-intro h2{margin:0;font-size:clamp(1.8rem,3vw,2.4rem)}.team-intro p{max-width:48rem;margin:0;color:var(--color-ink-2);font-size:1.05rem;line-height:1.6}.team-filters{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:2rem}.team-filters button{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem .9rem;border:1px solid var(--color-rule);background:white;color:var(--color-ink-2);font-size:.82rem;font-weight:700;cursor:pointer;transition:all .15s ease}.team-filters button span{padding:.1rem .35rem;background:var(--color-paper-2);color:var(--color-ink-3);font-size:.7rem}.team-filters button[aria-pressed="true"]{background:var(--color-board);border-color:var(--color-board);color:white}.team-filters button[aria-pressed="true"] span{background:rgba(255,255,255,.2);color:white}.team-grid{display:grid;gap:1.5rem;margin:0;padding:0;list-style:none}.team-grid li{background:white;border:1px solid var(--color-rule);transition:transform .2s ease,box-shadow .2s ease}.team-grid li:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(23,47,64,.08)}.team-grid a{display:flex;flex-direction:column;height:100%;padding:1.25rem;color:inherit;text-decoration:none}.team-grid img{display:block;width:100%;aspect-ratio:4/4.8;object-fit:cover;object-position:top;background:var(--color-paper-2);filter:saturate(.85)}.team-grid .profile-note{display:inline-block;margin-top:.75rem;padding:.3rem .5rem;background:var(--color-board);color:white;font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.team-grid h2{margin:.85rem 0 0;font-family:var(--font-serif);font-size:1.35rem}.team-grid h2 small{color:var(--color-crimson-deep);font-family:var(--font-sans);font-size:.78rem;font-weight:700}.team-grid p{flex-grow:1;margin:.35rem 0 0;color:var(--color-ink-3);font-size:.82rem;line-height:1.4}.profile-link{margin-top:1rem;color:var(--color-crimson-deep);font-size:.78rem;font-weight:700}@media(min-width:40rem){.team-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:64rem){.team-grid{grid-template-columns:repeat(3,1fr)}}@media(min-width:80rem){.team-grid{grid-template-columns:repeat(4,1fr)}}
  </style>
</Page>
