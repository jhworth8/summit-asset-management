---
import Page from '../layouts/Page.astro';
import { teamProfiles } from '../data/profiles';

const filters = [
  ['all', 'All'],
  ['chairman', 'Chairman'],
  ['principals', 'Principals'],
  ['advisors', 'Advisors'],
  ['associates', 'Associates'],
];
---

<Page title="Our Team | Summit Asset Management" description="Meet Summit Asset Management's experienced, collaborative team of advisors and professionals in Memphis." section="Our Team" heading="Experienced people. Collective perspective." intro="Clients have a primary advisor and the benefit of a collaborative firm with deep and diverse experience.">
  <div class="team-intro">
    <h2>A personal relationship, supported by a team.</h2>
    <p>Summit’s culture ensures that each client benefits from the firm’s collective knowledge without losing the personal touch of a primary advisor who knows the relationship in depth.</p>
  </div>

  <div class="team-filters" role="group" aria-label="Filter team by role" data-team-filters>
    {filters.map(([value, label], index) => (
      <button type="button" data-team-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>
        {label}<span>{value === 'all' ? teamProfiles.length : teamProfiles.filter((person) => person.group === value).length}</span>
      </button>
    ))}
  </div>

  <ul class="team-grid" data-team-grid>
    {teamProfiles.map((person) => (
      <li data-team-member data-team-group={person.group}>
        <a href={`/our-team/${person.slug}`}>
          <img src={person.photo} alt={person.name} width="600" height="720" loading="lazy" />
          {person.note && <span class="profile-note">{person.note}</span>}
          <h2>{person.name}{person.credentials && <small>, {person.credentials}</small>}</h2>
          <p>{person.title}</p>
          <span class="profile-link">Read biography →</span>
        </a>
      </li>
    ))}
  </ul>

  <script>
    const setupTeamFilters = () => {
      document.querySelectorAll<HTMLElement>('[data-team-filters]').forEach((controls) => {
        if (controls.dataset.ready === 'true') return;
        controls.dataset.ready = 'true';
        const grid = controls.nextElementSibling;
        const members = [...(grid?.querySelectorAll<HTMLElement>('[data-team-member]') || [])];
        const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-team-filter]')];
        buttons.forEach((button) => button.addEventListener('click', () => {
          const filter = button.dataset.teamFilter || 'all';
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          members.forEach((member) => { member.hidden = filter !== 'all' && member.dataset.teamGroup !== filter; });
        }));
      });
    };
    setupTeamFilters();
    document.addEventListener('astro:page-load', setupTeamFilters);
  </script>

  <style>
    .team-intro{display:grid;gap:1rem;margin-bottom:1.7rem;padding-bottom:2rem;border-bottom:1px solid var(--color-ink)}
    .team-intro h2{max-width:18ch;margin:0;font-size:clamp(2rem,4vw,3rem);line-height:1}
    .team-intro p{max-width:40rem;margin:0;color:var(--color-ink-2);line-height:1.6}
    .team-filters{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:2rem}
    .team-filters button{display:flex;gap:.55rem;align-items:center;padding:.6rem .75rem;border:1px solid var(--color-rule);background:white;color:var(--color-board);font:700 .75rem var(--font-sans);cursor:pointer}
    .team-filters button span{display:grid;min-width:1.25rem;height:1.25rem;place-items:center;border-radius:50%;background:var(--color-paper-2);font-size:.62rem}
    .team-filters button[aria-pressed="true"]{border-color:var(--color-board);background:var(--color-board);color:white}
    .team-filters button[aria-pressed="true"] span{background:var(--color-crimson);color:white}
    .team-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem 1rem;margin:0;padding:0;list-style:none}
    .team-grid li{animation:member-in .35s var(--ease-out-soft)}
    .team-grid a{display:block;position:relative}
    .team-grid img{display:block;width:100%;aspect-ratio:4/4.8;object-fit:cover;object-position:top;filter:saturate(.75)}
    .team-grid h2{margin:.75rem 0 0;color:var(--color-board);font-size:1.25rem;line-height:1.05}
    .team-grid h2 small{font-size:.8em;font-weight:500}
    .team-grid p{margin:.25rem 0 0;color:var(--color-ink-3);font-size:.78rem;line-height:1.35}
    .profile-link{display:inline-block;margin-top:.65rem;border-bottom:1px solid currentColor;color:var(--color-crimson-deep);font-size:.76rem;font-weight:700}
    .profile-note{position:absolute;top:.5rem;left:.5rem;padding:.3rem .45rem;background:var(--color-board);color:white;font-size:.64rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
    @keyframes member-in{from{opacity:0;transform:translateY(.5rem)}}
    @media(min-width:44rem){.team-grid{grid-template-columns:repeat(4,1fr)}}
    @media(min-width:64rem){.team-intro{grid-template-columns:1fr 1fr;align-items:end}.team-grid{grid-template-columns:repeat(4,1fr);gap:2.5rem 1.25rem}}
    @media(prefers-reduced-motion:reduce){.team-grid li{animation:none}}
  </style>
</Page>
