---
import Page from '../layouts/Page.astro';
import ServicesEditorial from '../components/ServicesEditorial.astro';
import content from '../content/pages/services.json';

const subnav = [
  { label: 'Overview', href: '/services' },
  { label: 'Investment management', href: '/services/investment-management' },
  { label: 'Financial planning', href: '/services/financial-planning' },
];
---

<Page title={content.seoTitle} description={content.seoDescription} section="Services" heading={content.heading} intro={content.intro} subnav={subnav}>
  <ServicesEditorial />
</Page>

