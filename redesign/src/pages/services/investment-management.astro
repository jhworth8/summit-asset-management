---
import Page from '../../layouts/Page.astro';
import ProcessStepper from '../../components/ProcessStepper.astro';
import content from '../../content/pages/investment.json';
import { firm } from '../../data/site';
import { p } from '../../utils/paths';

const subnav = [
  { label: 'Overview', href: '/services' },
  { label: 'Investment management', href: '/services/investment-management' },
  { label: 'Financial planning', href: '/services/financial-planning' },
];
---

<Page
  title={content.seoTitle}
  description={content.seoDescription}
  section="Services"
  heading={content.heading}
  intro={content.intro}
  image={content.image}
  imageAlt={content.imageAlt}
  subnav={subnav}
>
  <section class="service-editorial-lead">
    <div class="lead-header">
      <p class="section-kicker">{content.leadKicker}</p>
      <h2>{content.leadHeading}</h2>
    </div>
    <div class="lead-prose">
      <p class="lead-emphasis">{content.leadEmphasis}</p>
      <p>{content.leadBody}</p>
    </div>
  </section>

  <ProcessStepper
    id="investment-process"
    kicker={content.processKicker}
    heading={content.processHeading}
    intro={content.processIntro}
    steps={content.steps}
  />

  <section class="schedule-section" aria-labelledby="vehicles-heading">
    <div class="schedule-header">
      <p class="section-kicker">{content.vehiclesKicker}</p>
      <h2 id="vehicles-heading">{content.vehiclesHeading}</h2>
      <p>{content.vehiclesIntro}</p>
    </div>
    <ul class="schedule-grid">
      {content.vehicles.map((group) => (
        <li>
          <h3>{group.name}</h3>
          {group.items.length > 0 && <ul>{group.items.map((item) => <li>{item}</li>)}</ul>}
        </li>
      ))}
    </ul>
    {content.vehiclesNote && <p class="schedule-note">{content.vehiclesNote}</p>}
  </section>

  <section class="commitments-strip" aria-label="Firm attributes">
    {content.commitments.map((item) => (
      <div class="commitment-item">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </div>
    ))}
  </section>

  <div class="service-action-banner">
    <div class="action-copy">
      <p class="action-kicker">{content.ctaKicker}</p>
      <h2>{content.ctaHeading}</h2>
      <p>{content.ctaBody}</p>
    </div>
    <div class="action-links">
      <a href={p('/contact')} class="solid-button">{content.ctaButton}</a>
      <a href={firm.phoneHref} class="phone-link">
        <span>Call our office</span>
        <strong>{firm.phone}</strong>
      </a>
      <a href={p('/services/financial-planning')} class="sibling-link">Explore financial planning →</a>
    </div>
  </div>

  <nav class="service-pager" aria-label="Services navigation">
    <a href={p('/services')} class="pager-prev">
      <span>Previous</span>
      <strong>← Services overview</strong>
    </a>
    <a href={p('/services/financial-planning')} class="pager-next">
      <span>Next</span>
      <strong>Financial planning →</strong>
    </a>
  </nav>

  <style>
    .section-kicker {
      margin: 0 0 0.5rem 0;
      color: var(--color-crimson-deep);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .service-editorial-lead {
      display: grid;
      gap: 2.5rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--color-rule);
    }

    .lead-header h2 {
      max-width: 17ch;
      margin: 0;
      font-size: clamp(2.1rem, 3.8vw, 3.2rem);
      line-height: 1.05;
      color: var(--color-board);
    }

    .lead-prose {
      max-width: 44rem;
      color: var(--color-ink-2);
      font-size: 1.02rem;
      line-height: 1.68;
    }

    .lead-emphasis {
      color: var(--color-board);
      font-size: 1.12rem;
      font-weight: 500;
      line-height: 1.6;
      margin-top: 0;
    }

    @media (min-width: 60rem) {
      .service-editorial-lead {
        grid-template-columns: 0.85fr 1.15fr;
        gap: 4.5rem;
      }
    }

    /* Commitments Strip */
    .commitments-strip {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1px;
      margin-top: 3.5rem;
      background: var(--color-rule);
      border: 1px solid var(--color-rule);
    }

    @media (min-width: 54rem) {
      .commitments-strip {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .commitment-item {
      background: #ffffff;
      padding: 2rem 1.75rem;
      display: flex;
      flex-direction: column;
    }

    .commitment-tag {
      color: var(--color-crimson);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .commitment-item h3 {
      margin: 0.35rem 0 0.5rem 0;
      font-size: 1.3rem;
      color: var(--color-board);
    }

    .commitment-item p {
      margin: 0;
      color: var(--color-ink-2);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    /* Action Banner */
    .service-action-banner {
      display: grid;
      gap: 2.5rem;
      margin-top: 3.5rem;
      padding: 3rem 2.5rem;
      background: var(--color-board);
      color: #ffffff;
    }

    .action-kicker {
      margin: 0 0 0.5rem 0;
      color: var(--color-crimson-light);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .action-copy h2 {
      margin: 0 0 1rem 0;
      color: #ffffff;
      font-size: clamp(1.85rem, 3vw, 2.4rem);
      line-height: 1.15;
    }

    .action-copy p {
      max-width: 34rem;
      margin: 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .action-links {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.25rem;
    }

    .solid-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.9rem 1.75rem;
      background: var(--color-crimson);
      color: #ffffff;
      font-size: 0.94rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s ease;
      width: fit-content;
    }

    .solid-button:hover {
      background: var(--color-crimson-deep);
    }

    .phone-link {
      display: flex;
      flex-direction: column;
      color: rgba(255, 255, 255, 0.88);
      text-decoration: none;
      font-size: 0.85rem;
    }

    .phone-link span {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.76rem;
    }

    .phone-link strong {
      font-size: 1.2rem;
      color: #ffffff;
      font-family: var(--font-serif);
      letter-spacing: 0.03em;
    }

    .sibling-link {
      margin-top: 0.5rem;
      color: var(--color-crimson-light);
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .sibling-link:hover {
      color: #ffffff;
    }

    @media (min-width: 56rem) {
      .service-action-banner {
        grid-template-columns: 1.2fr 0.8fr;
        align-items: center;
        gap: 4rem;
      }
    }

    /* Bottom Page Navigation Pager */
    .service-pager {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-rule);
    }

    .service-pager a {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: var(--color-board);
      transition: color 0.2s ease;
    }

    .service-pager a:hover {
      color: var(--color-crimson);
    }

    .service-pager a span {
      color: var(--color-ink-3);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .service-pager a strong {
      font-family: var(--font-serif);
      font-size: 1.2rem;
      margin-top: 0.2rem;
      color: inherit;
    }

    .service-pager .pager-next {
      text-align: right;
      margin-left: auto;
    }

    /* Schedule of investments */
    .schedule-section {
      padding-top: 1rem;
    }

    .schedule-header h2 {
      margin: 0 0 0.6rem;
      color: var(--color-board);
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      line-height: 1.1;
    }

    .schedule-header > p:last-child {
      max-width: 44rem;
      margin: 0 0 1.75rem;
      color: var(--color-ink-2);
      line-height: 1.6;
    }

    .schedule-grid {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--color-ink);
    }

    .schedule-grid > li {
      padding: 1.2rem 0;
      border-bottom: 1px solid var(--color-rule);
    }

    .schedule-grid h3 {
      margin: 0;
      color: var(--color-board);
      font-size: 1.3rem;
    }

    .schedule-grid ul {
      margin: 0.5rem 0 0;
      padding: 0;
      list-style: none;
      color: var(--color-ink-2);
      font-size: 0.92rem;
      line-height: 1.7;
    }

    .schedule-grid ul li::before {
      content: '— ';
      color: var(--color-crimson);
    }

    .schedule-note {
      max-width: 44rem;
      margin: 1.25rem 0 0;
      color: var(--color-ink-3);
      font-size: 0.85rem;
      line-height: 1.55;
    }

    @media (min-width: 54rem) {
      .schedule-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .schedule-grid > li {
        padding: 1.4rem 1.5rem;
        border-right: 1px solid var(--color-rule);
        border-bottom: 0;
      }

      .schedule-grid > li:first-child {
        padding-left: 0;
      }

      .schedule-grid > li:last-child {
        border-right: 0;
      }
    }
  </style>
</Page>
