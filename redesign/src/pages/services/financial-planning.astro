---
import Page from '../../layouts/Page.astro';
import PlanningDiagram from '../../components/PlanningDiagram.astro';

const subnav = [
  { label: 'Overview', href: '/services' },
  { label: 'Investment management', href: '/services/investment-management' },
  { label: 'Financial planning', href: '/services/financial-planning' },
];
---

<Page
  title="Financial Planning | Summit Asset Management"
  description="Comprehensive, concrete, and coordinated fee-only financial planning for individuals, families, businesses and nonprofits in Memphis."
  section="Services"
  heading="Clarity for everyday questions and complex milestones."
  intro="Summit takes a comprehensive view, outlines concrete actions, coordinates with other professionals and keeps the plan connected over time."
  image="/img/SAM_MG_8222_enhanced.webp"
  imageAlt="A client conversation and financial planning session at Summit Asset Management"
  subnav={subnav}
>
  <!-- Philosophy & Lead Editorial -->
  <section class="service-editorial-lead">
    <div class="lead-header">
      <p class="section-kicker">Planning Philosophy</p>
      <h2>Unbiased direction across the whole financial life.</h2>
    </div>
    <div class="lead-prose">
      <p class="lead-emphasis">
        Whether it is a decision to sell a business or a question about how much is enough insurance, our advisors and professionals provide unbiased advice and helpful direction.
      </p>
      <p>
        We suggest specific solutions as we analyze and organize our clients’ financial information, working together with tax and legal counsel to integrate all of the pieces into one clear, connected plan.
      </p>
    </div>
  </section>

  <!-- Interactive Figures: 4-C Disciplines & Practice Matrix -->
  <PlanningDiagram />

  <!-- Multi-Disciplinary Coordination -->
  <section class="coordination-strip">
    <div class="coordination-header">
      <p class="section-kicker">Collaborative Advisory</p>
      <h2>Orchestrating your entire financial team.</h2>
    </div>
    <div class="coordination-grid">
      <div class="coord-item">
        <span class="coord-tag">Tax Strategy</span>
        <h3>CPAs & Tax Counsel</h3>
        <p>Annual tax-loss harvesting, timing of deductions, asset location, and Roth conversion planning.</p>
      </div>
      <div class="coord-item">
        <span class="coord-tag">Legacy Structure</span>
        <h3>Estate & Trust Attorneys</h3>
        <p>Aligning asset titling, powers of attorney, and beneficiary designations with trust documents.</p>
      </div>
      <div class="coord-item">
        <span class="coord-tag">Stewardship</span>
        <h3>Successor Fiduciaries</h3>
        <p>Serving as an institutional repository of family history, values, and multi-generational wisdom.</p>
      </div>
    </div>
  </section>

  <!-- Action Callout Banner -->
  <div class="service-action-banner">
    <div class="action-copy">
      <p class="action-kicker">Next Steps</p>
      <h2>Bring the pieces together.</h2>
      <p>
        Ready to develop a unified roadmap for your family or organization? Contact our Memphis office to start a thoughtful, confidential conversation.
      </p>
    </div>
    <div class="action-links">
      <a href="/contact" class="solid-button" target="_blank" rel="noopener noreferrer">Talk with an advisor</a>
      <a href="tel:9017298100" class="phone-link">
        <span>Direct line to Memphis office:</span>
        <strong>901.729.8100</strong>
      </a>
      <a href="/services/investment-management" class="sibling-link">
        Explore Investment Management →
      </a>
    </div>
  </div>

  <!-- Bottom Page Navigation -->
  <nav class="service-pager" aria-label="Services navigation">
    <a href="/services/investment-management" class="pager-prev">
      <span>Previous</span>
      <strong>← Investment Management</strong>
    </a>
    <a href="/services" class="pager-next">
      <span>Overview</span>
      <strong>Services Overview →</strong>
    </a>
  </nav>

  <style>
    .section-kicker {
      margin: 0 0 0.5rem 0;
      color: var(--color-crimson-deep);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .service-editorial-lead {
      display: grid;
      gap: 2.5rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--color-rule);
    }

    .lead-header h2 {
      max-width: 17ch;
      margin: 0;
      font-size: clamp(2.1rem, 3.8vw, 3.2rem);
      line-height: 1.05;
      color: var(--color-board);
    }

    .lead-prose {
      max-width: 44rem;
      color: var(--color-ink-2);
      font-size: 1.02rem;
      line-height: 1.68;
    }

    .lead-emphasis {
      color: var(--color-board);
      font-size: 1.12rem;
      font-weight: 500;
      line-height: 1.6;
      margin-top: 0;
    }

    @media (min-width: 60rem) {
      .service-editorial-lead {
        grid-template-columns: 0.85fr 1.15fr;
        gap: 4.5rem;
      }
    }

    /* Coordination Strip */
    .coordination-strip {
      margin-top: 3.5rem;
      padding-top: 3rem;
      border-top: 1px solid var(--color-rule);
    }

    .coordination-header h2 {
      max-width: 18ch;
      margin: 0.25rem 0 2rem 0;
      font-size: clamp(1.85rem, 3vw, 2.4rem);
      color: var(--color-board);
    }

    .coordination-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1px;
      background: var(--color-rule);
      border: 1px solid var(--color-rule);
    }

    @media (min-width: 54rem) {
      .coordination-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .coord-item {
      background: #ffffff;
      padding: 2rem 1.75rem;
      display: flex;
      flex-direction: column;
    }

    .coord-tag {
      color: var(--color-crimson);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .coord-item h3 {
      margin: 0.35rem 0 0.5rem 0;
      font-size: 1.3rem;
      color: var(--color-board);
    }

    .coord-item p {
      margin: 0;
      color: var(--color-ink-2);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    /* Action Banner */
    .service-action-banner {
      display: grid;
      gap: 2.5rem;
      margin-top: 3.5rem;
      padding: 3rem 2.5rem;
      background: var(--color-board);
      color: #ffffff;
    }

    .action-kicker {
      margin: 0 0 0.5rem 0;
      color: var(--color-crimson-light);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .action-copy h2 {
      margin: 0 0 1rem 0;
      color: #ffffff;
      font-size: clamp(1.85rem, 3vw, 2.4rem);
      line-height: 1.15;
    }

    .action-copy p {
      max-width: 34rem;
      margin: 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .action-links {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.25rem;
    }

    .solid-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.9rem 1.75rem;
      background: var(--color-crimson);
      color: #ffffff;
      font-size: 0.94rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s ease;
      width: fit-content;
    }

    .solid-button:hover {
      background: var(--color-crimson-deep);
    }

    .phone-link {
      display: flex;
      flex-direction: column;
      color: rgba(255, 255, 255, 0.88);
      text-decoration: none;
      font-size: 0.85rem;
    }

    .phone-link span {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.76rem;
    }

    .phone-link strong {
      font-size: 1.2rem;
      color: #ffffff;
      font-family: var(--font-serif);
      letter-spacing: 0.03em;
    }

    .sibling-link {
      margin-top: 0.5rem;
      color: var(--color-crimson-light);
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .sibling-link:hover {
      color: #ffffff;
    }

    @media (min-width: 56rem) {
      .service-action-banner {
        grid-template-columns: 1.2fr 0.8fr;
        align-items: center;
        gap: 4rem;
      }
    }

    /* Bottom Page Navigation Pager */
    .service-pager {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-rule);
    }

    .service-pager a {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: var(--color-board);
      transition: color 0.2s ease;
    }

    .service-pager a:hover {
      color: var(--color-crimson);
    }

    .service-pager a span {
      color: var(--color-ink-3);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .service-pager a strong {
      font-family: var(--font-serif);
      font-size: 1.2rem;
      margin-top: 0.2rem;
      color: inherit;
    }

    .service-pager .pager-next {
      text-align: right;
      margin-left: auto;
    }
  </style>
</Page>
